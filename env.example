# Discord bot token. Keep this out of GitHub in real use.
DISCORD_TOKEN=put_discord_bot_token_here

# Optional. Set for instant slash command sync to one Discord server while testing.
DISCORD_GUILD_ID=

# Runtime data root. Existing installs may retain METRO_BOT_DATA_DIR while
# migrating, but new installs should use the NR-specific name.
NRBOT_DATA_DIR=/var/lib/nr-bot

# Network Rail Open Data credentials.
NROD_USER=
NROD_PASS=

# Alternative names also accepted.
NR_USERNAME=
NR_PASSWORD=

NR_ENABLED=true
NR_AREA=T3
NR_TOPIC=/topic/TD_ALL_SIG_AREA
NR_HOST=publicdatafeeds.networkrail.co.uk
NR_PORT=61618

# Advanced network monitor. NR_AREA remains the legacy signal learner's T3
# scope; NR_AREAS independently controls the wider berth map and analysis.
NR_ADVANCED_ENABLED=true
NR_AREAS=T0,T1,T2,T3
NR_TRUST_ENABLED=true
NR_TSR_ENABLED=true
NR_VSTP_ENABLED=true
NR_REFERENCE_AUTO_REFRESH=true
# Enable the corresponding feeds and All Reference Data on your NR account.
# All subscriptions share the existing STOMP connection/client ID.
NR_DURABLE_SUBSCRIPTION=true
NR_SUBSCRIPTION_ID=metro-nr-bot-t3
NR_DURABLE_NAME=metro-nr-bot-t3

# Local web map. To use a phone, bind to the LXC's LAN/Tailscale address,
# generate a random access key (24+ characters) and set its reachable URL.
NR_MAP_ENABLED=true
NR_MAP_BIND=127.0.0.1
NR_MAP_PORT=8790
NR_MAP_TOKEN=
NR_MAP_PUBLIC_URL=

# Conservative data quality and running-time thresholds.
NR_NETWORK_STALE_SECONDS=180
NR_BERTH_MAX_AGE_SECONDS=1800
NR_BASELINE_MIN_SAMPLES=8
NR_SLOW_RATIO=1.8
NR_SLOW_EXTRA_SECONDS=45
NR_TRUST_DELAY_GAIN_MINUTES=2
NR_NETWORK_RETENTION_DAYS=14
# The direct TRUST feed has documented BST wall-time fields. Use utc only for
# an upstream source which already corrected those fields. TD/TSR stay UTC.
NR_TRUST_CLOCK=network-rail

# Optional Discord alerts. Blank disables posting. Three distinct headcodes on
# the same section in 15 min by default; repeated alerts have a 15 min cooldown.
NR_ALERT_CHANNEL_ID=
NR_ALERT_MIN_TRAINS=3

# Read-only private T3 bridge. This never starts as plain HTTP: all three TLS
# files and the authorised Metro client identity are mandatory when enabled.
T3_API_ENABLED=false
T3_API_BIND=10.77.0.1
T3_API_PORT=8765
T3_API_SERVER_CERT=/etc/nr-bot/tls/server.crt
T3_API_SERVER_KEY=/etc/nr-bot/tls/server.key
T3_API_CLIENT_CA=/etc/nr-bot/tls/ca.crt
T3_API_ALLOWED_CLIENT_CN=metro-bot
T3_API_STALE_SECONDS=180
# Durable CA/CC/CB cursor history. A stale Metro cursor recovers from the
# conservative snapshot, then continues with the retained range.
T3_API_EVENT_RETENTION_DAYS=7

# Optional mapping overrides. Defaults are the two CSV files shipped beside bot.py.
# T3_API_BERTH_DESCRIPTIONS=/opt/nr-bot/berth-to-description.csv
# T3_API_STEP_DESCRIPTIONS=/opt/nr-bot/berth-step-to-description.csv

# Optional, reserved for future terminal log posting.
TERMINAL_LOGS_CHANNEL_ID=
